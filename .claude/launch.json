{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "webapi.api:app", "--app-dir", "src", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "streamlit",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "streamlit_app/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
