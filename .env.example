# Copy this to .env and fill in real values. DO NOT commit .env.
# For Docker --env-file compatibility, use unquoted NAME=value entries and
# keep comments on separate lines. Existing shell variables override local .env.

# --- LLM (for synthesis) ---
# Tested with Gemini on 2026-09-16; choose a model available to your account.
# Supported providers: anthropic | openai | gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Web search provider ---
# Supported providers: tavily | serper | duckduckgo
WEB_SEARCH_PROVIDER=tavily
# Create a key at https://app.tavily.com and paste it only into your local .env.
# Check your quota at https://app.tavily.com.
TAVILY_API_KEY=
# SERPER_API_KEY=
# (DuckDuckGo needs no key but the duckduckgo-search package must be installed.)

# --- Application settings ---
LOG_LEVEL=INFO
MAX_QUESTION_LENGTH=2000
PER_SOURCE_TIMEOUT_SECONDS=10
MAX_SOURCES_PER_QUERY=3

# Includes the initial attempt.
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=4

CACHE_TTL_SECONDS=86400

# Optional SQLite file URL. Blank uses ~/.cache/research-assistant/sources.sqlite3.
# Relative: sqlite:///.cache/sources.sqlite3
# Windows absolute: sqlite:///C:/path/to/sources.sqlite3
# Linux absolute: sqlite:////path/to/sources.sqlite3
# --no-cache bypasses SQLite entirely.
DATABASE_URL=
